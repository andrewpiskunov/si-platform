# Mount a real secret matching METRICS_TOKEN at the credentials_file path.
# This example assumes Prometheus shares the private Compose network.
global:
  scrape_interval: 15s
  evaluation_interval: 15s
rule_files:
  - /etc/prometheus/alerts.yml
scrape_configs:
  - job_name: si-platform
    scrape_timeout: 6s
    metrics_path: /metrics
    authorization:
      type: Bearer
      credentials_file: /run/secrets/metrics_token
    static_configs:
      - targets: ['api:9090']
# Configure Alertmanager and its recipients separately before public launch.
