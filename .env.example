# Local development only. Compose reads this file after copying it to .env.
POSTGRES_PASSWORD=local-dev-only
POSTGRES_PORT=5432
PORT=8080
DATABASE_URL=postgres://si:local-dev-only@127.0.0.1:5432/si?sslmode=disable
LISTEN_ADDR=127.0.0.1:8080
ALLOWED_ORIGIN=http://localhost:8080
# For Svelte dev: ALLOWED_ORIGIN=http://localhost:5173; API_ORIGIN stays server-side.
DATA_DIR=.local/data
# Isolated media processing requires Linux user namespaces and these executables.
# Leave paths empty to resolve them from PATH. Explicit true enables text-only mode.
MEDIA_DISABLED=false
MEDIA_FFMPEG=
MEDIA_FFPROBE=
MEDIA_SANDBOX=
MEDIA_PRLIMIT=
API_ORIGIN=http://127.0.0.1:8080
# Empty S3_BUCKET selects local private object storage (Linux + flock).
# S3 requires bucket versioning Enabled. Grant GetBucketVersioning,
# ListBucketVersions, DeleteObjectVersion plus ordinary private read/write.
# Never suspend versioning or install unconditional lifecycle deletion of live keys.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_PATH_STYLE=true
S3_ACCESS_KEY=
S3_SECRET_KEY=
