# Local development only. Compose reads this file after copying it to .env.
POSTGRES_PASSWORD=local-dev-only
POSTGRES_PORT=5432
PORT=8080
DATABASE_URL=postgres://si:local-dev-only@127.0.0.1:5432/si?sslmode=disable
LISTEN_ADDR=127.0.0.1:8080
ALLOWED_ORIGIN=http://localhost:8080
# For Svelte dev: ALLOWED_ORIGIN=http://localhost:5173; API_ORIGIN stays server-side.
DATA_DIR=.local/data
# Isolated media processing requires Linux user namespaces and these executables.
# Leave paths empty to resolve them from PATH. Explicit true enables text-only mode.
MEDIA_DISABLED=false
MEDIA_FFMPEG=
MEDIA_FFPROBE=
MEDIA_SANDBOX=
MEDIA_PRLIMIT=
API_ORIGIN=http://127.0.0.1:8080
# Empty S3_BUCKET selects local private object storage (Linux + flock).
# S3 requires bucket versioning Enabled. Grant GetBucketVersioning,
# ListBucketVersions, DeleteObjectVersion plus ordinary private read/write.
# Never suspend versioning or install unconditional lifecycle deletion of live keys.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_PATH_STYLE=true
S3_ACCESS_KEY=
S3_SECRET_KEY=

# AI is disabled by default. Real generation requires explicit operator settings.
# fixture is deterministic, makes no network calls, and requires numeric loopback LISTEN_ADDR.
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=
# Positive integers: microUSD per million tokens; monthly cap in microUSD.
# Set current model tariffs yourself; these are internal budget estimates.
AI_INPUT_MICRO_USD_PER_MILLION=
AI_OUTPUT_MICRO_USD_PER_MILLION=
AI_MONTHLY_MICRO_USD=
AI_MAX_OUTPUT_TOKENS=16384

# Optional private metrics listener, not exposed by Caddy or Compose host ports.
# Example inside Compose: METRICS_ADDR=0.0.0.0:9090; local: 127.0.0.1:9090.
# Separate secret, 32..256 printable non-space ASCII characters. Never reuse a user PAT.
METRICS_ADDR=
METRICS_TOKEN=

# Optional SIBrowser cron job: token of the configured source admin, drafts:read/write.
# Configure owner and explicit storage/pack quotas using sibrowser-sync first.
SI_SYNC_API_TOKEN=
